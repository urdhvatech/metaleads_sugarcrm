<div class="flex pill-font-size flex-col">
    {{#if value}}
        <div class="w-inherit px-4 font-bold rounded-xl text-center whitespace-nowrap pill-{{value}}">
            <span class="base-badge label pill-{{value}} pill-text-color-{{value}}">
                    {{#if value includeZero=true}}
                        {{#eachOptions items}}
                            {{#eq this.key ../value}}
                                <div class="ellipsis_inline pill-text-size"
                                    data-bs-placement="bottom"
                                    title="{{value}}">
                                    {{value}}
                                </div>
                            {{/eq}}
                        {{/eachOptions}}
                    {{/if}}
            </span>
        </div>
    {{/if}}
    {{#if _dateGenerated}}
        <span class="list">
            <div class="base-badge label ellipsis_inline font-normal adjust-date-font">{{_dateGenerated}}</div>
        </span>
    {{/if}}
</div>

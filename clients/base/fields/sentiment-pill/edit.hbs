<div class="flex flex-col">
    {{#if value}}
        <div class="w-fit px-4 font-semibold rounded-xl text-center whitespace-nowrap pill-{{value}}">
            <span class="base-badge label  pill-{{value}} pill-text-color-{{value}}">
                    {{#if value includeZero=true}}
                        {{#eachOptions items}}
                            {{#eq this.key ../value}}
                                <div class="ellipsis_inline pill-font-size"
                                    data-bs-placement="bottom"
                                    title="{{value}}">
                                    {{value}}
                                </div>
                            {{/eq}}
                        {{/eachOptions}}
                    {{/if}}
            </span>
        </div>
    {{/if}}
    {{#if _dateGenerated}}
        <div class="flex shrink min-w-0 overflow-hidden items-center">
            <span class="base-badge label font-normal adjust-date-font-edit  inline-block
                whitespace-nowrap overflow-hidden text-ellipsis w-full text-left bg-none border-0">
                {{_dateGenerated}}
            </span>
        </div>
    {{/if}}
</div>

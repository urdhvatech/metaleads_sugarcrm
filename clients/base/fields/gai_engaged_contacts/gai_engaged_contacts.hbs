{{#if engagedContacts}}
   <div class="flex flex-col">
        {{#each engagedContacts}}
            {{#isString this}}
                <div class="flex">
                    <div class="text-sm leading-4 text-gray-800 dark:text-gray-300">{{this}}</div>
                </div>
            {{else}}
                <div class="flex flex-col gap-3">
                    {{#each this}}
                        <div class="flex flex-col gap-1 relate-field-container ellipsis_inline" data-bs-placement="bottom">
                            <div class="flex flex-row justify-between items-center group">
                                <div role="button"
                                    class="inline-flex items-center border overflow-hidden max-w-full p-1 rounded-xl
                                        border-gray-300 dark:bg-gray-800 dark:border-gray-600
                                        mb-0.5 engaged-contact-pill"
                                    >
                                    <i class="sicon {{icon}} label-module-size-sm {{iconColor}}
                                            mr-2 w-5 h-5 rounded-full inline-flex items-center justify-center">
                                    </i>
                                    <a href="{{link}}"
                                        class="font-normal no-underline whitespace-nowrap overflow-hidden
                                            text-ellipsis text-xs leading-[18px] text-blue-600 dark:text-blue-300"
                                        title="{{name}}"
                                        data-module="{{moduleName}}"
                                        data-id="{{objectId}}"
                                        >{{name}}{{#if title}}, {{title}}{{/if}}
                                    </a>
                                </div>
                                <span class="focus-icon-container">
                                        <span class="focus-icon sicon sicon-focus-drawer  opacity-0 group-hover:opacity-100" tabindex="0" role="button"
                                            aria-label="{{str 'LBL_FOCUS_DRAWER_DASHBOARD'}}"
                                            rel="tooltip"
                                            data-original-title="{{str 'LBL_FOCUS_DRAWER_DASHBOARD'}}"
                                            data-bs-placement="bottom"
                                            data-module="{{moduleName}}"
                                            data-id="{{objectId}}"
                                            data-name="{{name}}"
                                        ></span>
                                </span>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{/isString}}
        {{/each}}
    </div>
{{else}}
        <div>{{invalidEngagedContacts}}</div>
{{/if}}

{{#each summaryFragment}}
    <div class="px-2.5">
        {{#if @key}}
        <div class="flex">
            <div
                class="rounded-full mr-2 w-1.5 h-1.5 mt-1.5 min-w-[6px] summary-item">
            </div>
            <span class="list">
                <div class="font-bold ellipsis_inline">
                    {{@key}}:
                </div>
            </span>
        </div>
        {{/if}}
        {{#isArray this}}
            {{partial
                'gai_summary_fragment'
                ../../this summaryFragment=../this
            }}
        {{else}}
            {{#isObject this}}
                <div class="mb-1">
                    {{#each this}}
                        <div class="flex">
                            <div
                                class="rounded-full mr-2 w-1.5 h-1.5 mt-1.5 min-w-[6px] summary-item">
                            </div>
                            {{#if @key}}
                                <span class="list">
                                    <div class="font-bold ellipsis_inline mr-2">
                                        {{@key}}:
                                    </div>
                                </span>
                            {{/if}}
                                <span class="list summary-list">
                                    <div class="ellipsis_inline">
                                        {{this}}
                                    </div>
                                </span>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="flex">
                    <div
                        class="rounded-full mr-2 w-1.5 h-1.5 mt-1.5 min-w-[6px] summary-item">
                    </div>
                    <span class="list summary-list">
                        <div class="ellipsis_inline">
                            {{this}}
                        </div>
                    </span>
                </div>
            {{/isObject}}
        {{/isArray}}
    </div>
{{/each}}

<div class="flex h-full w-full flex-col">
    <div class="px-2.5 flex flex-col h-full">
        <div class="flex my-1 flex-col">
            {{#if summary}}
                {{#each summary}}
                    <div class="mb-4">
                        {{#if @key}}
                            <span class="list">
                                <div class="font-bold ellipsis_inline">
                                    {{@key}}
                                </div>
                            </span>
                        {{/if}}
                        {{#isArray this}}
                            {{partial
                                'gai_summary_fragment'
                                ../../this summaryFragment=../this
                            }}
                        {{else}}
                            <div class="px-2.5 flex">
                                <div class="rounded-full mr-2 w-1.5 h-1.5 mt-1.5 min-w-[6px] summary-item">
                                </div>
                                {{#isObject this}}
                                    {{#each this}}
                                        <span class="list">
                                            <div class="font-bold ellipsis_inline">
                                                {{@key}}{{this}}
                                            </div>
                                        </span>
                                    {{/each}}
                                {{else}}
                                    <span class="list summary-list">
                                        <div class="ellipsis_inline">
                                            {{this}}
                                        </div>
                                    </span>
                                {{/isObject}}
                            </div>
                        {{/isArray}}
                    </div>
                {{/each}}
            {{else}}
                 <div class="font-bold">{{invalidSummary}}</div>
            {{/if}}
        </div>
    </div>
</div>

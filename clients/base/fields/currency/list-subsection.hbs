<div class="currency-field ellipsis_inline" data-target-additional="true" data-bs-placement="bottom" data-original-title="{{value}}"{{#if dir}} dir="{{dir}}"{{/if}} rel="tooltip" title="{{#if transactionalValue}}{{transactionalValue}} | {{value}}{{else}}{{value}}{{/if}}">
    {{#if transactionalValue}}
        <label class="original {{cssClass}}">{{sign}}{{transactionalValue}}</label><div class="converted {{cssClass}}">{{sign}}{{value}}</div>
    {{else}}
        <div class="{{cssClass}}">{{sign}}{{value}}</div>
    {{/if}}
</div>

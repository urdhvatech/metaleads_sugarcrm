{{#if neededFollowup}}
    <div class="flex relative flex flex-col pb-3">
        <div class="flex flex-col">
            {{#each neededFollowup}}
                {{#isString this}}
                    <div class="text-base font-semibold pb-3 text-fuschia-600 dark:text-fuschia-500">{{@key}}</div>
                    <div class="flex">
                        <div class="text-sm leading-4 text-gray-800 dark:text-gray-300">{{this}}</div>
                    </div>
                {{else}}
                    {{#if @key}}
                        <div class="text-base font-semibold pb-3 text-fuschia-600 dark:text-fuschia-500">{{@key}}</div>
                    {{/if}}
                    <div class="flex flex-col gap-3">
                        {{#each this}}
                            <div class="flex flex-col gap-1">
                                <div role="button"
                                    class="inline-flex items-center border border-gray-300 dark:bg-gray-800
                                    dark:border-gray-600 p-1 rounded-xl max-w-fit follow-up-pill"
                                    data-module="{{moduleName}}"
                                    data-id="{{objectId}}"
                                    data-name="{{name}}">
                                    <i class="sicon {{icon}} label-module-size-sm {{iconColor}}
                                        mr-2 w-5 h-5 rounded-full inline-flex items-center justify-center">
                                    </i>
                                    <a href="{{link}}"
                                        class="font-normal text-sm leading-[18px] no-underline whitespace-nowrap
                                        overflow-hidden text-ellipsis text-blue-600 dark:text-blue-300"
                                        title="{{name}}">{{name}}
                                    </a>
                                </div>
                                <div class="text-sm text-gray-800 dark:text-gray-300 leading-[16px] font-normal">
                                    {{followUp}}
                                </div>
                            </div>
                        {{/each}}
                    </div>
                {{/isString}}
            {{/each}}
        </div>
    </div>
{{/if}}

{{#if showBanner}}
<div class="mobile-banner">
    <div class="mobile-banner__close sicon sicon-close-lg"></div>
    <div class="mobile-banner__icon">
        {{partial "mobile-icon" this}}
    </div>
    <div class="mobile-banner__info">
        <div class="mobile-banner__title">{{str 'LBL_MOBILE_INSTALL_PROMPT'}}</div>
        <div class="mobile-banner__msg">
            {{str 'LBL_MOBILE_INSTALL_PROMPT_DESC'}}
        </div>
    </div>
    <div class="mobile-banner__btn"><i class="sicon sicon-download-lg"></i></div>
</div>
{{/if}}
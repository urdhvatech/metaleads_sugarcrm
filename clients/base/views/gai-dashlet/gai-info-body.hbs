<div>
    <div class="gai-token-usage-container"></div>
    <ul class="list-disc ps-5 ml-0 pb-1">
        <li class="py-1 text-sm leading-4">{{str "LBL_GAI_INFO_1"}}</li>
        <li class="py-1 text-sm leading-4">{{str "LBL_GAI_INFO_2"}}</li>
        <li class="py-1 text-sm leading-4">{{module_information}}<div class="asterisk inline-block">*</div></li>
        <li class="py-1 text-sm leading-4">{{str "LBL_GAI_INFO_4"}}</li>
        <li class="py-1 text-sm leading-4">{{str "LBL_GAI_LEARN_MORE"}}
            <a href={{url}} target="_blank" class= "text-blue-600">{{str "LBL_GAI_LEARN_MORE_LINK"}}</a>.
        </li>
    </ul>
    <div class="text-xs leading-4">
        <div class="asterisk inline-block">*</div>
        {{module_information_asterisk}}
    </div>
</div>

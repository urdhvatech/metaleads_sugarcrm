<tr>
    {{#each view.leftColumns}}
        <th{{#if name}} data-fieldname="{{name}}"{{/if}} class="sticky ltr:stick-left rtl:stick-right ltr:left-0 rtl:right-0 z-20">
            <span>
                {{field ../view template="list-header"}}
            </span>
        </th>
    {{/each}}
    {{#each view._fields.visible}}
        <th class="relative {{#isSortable ../view.module this}}sorting{{#eq ../../view.orderBy.field name}}_{{../../../view.orderBy.direction}}{{/eq}} orderBy{{name}}{{/isSortable}}{{#if widthClass}} {{widthClass}}{{/if}}
            {{#if ../view.isFirstColumnFreezed}}{{#if @first}} sticky stick-first{{#eq ../../../view.leftColumns.length 0}} ltr:left-0 rtl:right-0{{/eq}}{{/if}}{{/if}}"
            {{#if styles}} style="{{styles}}"{{/if}}
            {{#if name}} data-fieldname="{{name}}"{{/if}} data-orderby="{{orderBy}}"
            aria-label="{{str label ../view.module}}{{#isSortable ../view.module this}}, {{str 'LBL_ALT_SORTABLE'}}, {{#eq ../../view.orderBy.field name}}{{#eq ../../../view.orderBy.direction 'asc'}}{{str 'LBL_ALT_SORT_ASC'}}{{else}}{{str 'LBL_ALT_SORT_DESC'}}{{/eq}}{{else}}{{str 'LBL_ALT_NOT_SORTED'}}{{/eq}}{{else}}{{str 'LBL_ALT_NOT_SORTABLE'}}{{/isSortable}}">

            <div class="sortable-row-header-container p-2">
                {{#isSortable ../view.module this}}
                    <a class="sortable-row-header sortable-row-header w-full font-normal text-inherit" role="button">
                {{/isSortable}}
                {{#has "ReorderableColumns" ../view.plugins}}
                    {{! Insert a <div> around all the inner element of the column.
                    This is a fix for firefox because the <th> does not support
                    a relative positioning.}}

                    <div class="th-droppable-placeholder" data-droppableindex="{{@index}}"></div>
                    {{! Insert a <div> around the <span> containing the field label.
                        That <div> is the draggable element.
                        This is a fix for firefox because dragging a <th> is not
                        supported.}}
                    <div{{#has "ReorderableColumns" ../../view.plugins}} data-draggable="true"{{/has}}>
                {{/has}}
                <span class="sortable-row-header-column-name" aria-hidden="true">
                     {{#if icon}}
                         <i class="{{buildIcon icon.type}}" rel="tooltip"  title="{{str icon.tooltip ../../view.module}} "></i>
                     {{/if}}
                    {{str label ../view.module}}
                </span>
                {{#has "ReorderableColumns" ../view.plugins}}
                    </div>
                    {{#if @last}}
                        <div class="th-droppable-placeholder th-droppable-placeholder-last"
                             data-droppableindex="{{../../../view._fields.visible.length}}">
                        </div>
                    {{/if}}
                {{/has}}
                {{#isSortable ../view.module this}}
                    <span class="sortable-row-header-arrows" aria-hidden="true">
                        <i class="sicon sicon-arrow-up"></i>
                        <i class="sicon sicon-arrow-down"></i>
                    </span>
                </a>
                {{/isSortable}}
            </div>
        </th>
    {{/each}}
    {{#each view.rightColumns}}
        {{#if isColumnDropdown}}
            <th class="box-border ltr:!border-l-0 rtl:!border-r-0 morecol nosort ltr:stick-right rtl:stick-left">
                <div class="absolute dropdown ltr:border-l trl:border-r border-[--border-base] focus-within:z-30 ltr:right-0 rtl:left-0 z-10">
                    <button class="btn btn-invisible dropdown-toggle" data-bs-toggle="dropdown"
                        track="click:morecol" aria-label="{{str 'LBL_COLUMNS'}}" aria-haspopup="true"
                        aria-expanded="false" role="button" data-action="fields-toggle" data-bs-display="static"
                    >
                        <i class="sicon sicon-kebab"></i>
                        {{tooltipTemplate (str 'LBL_COLUMNS') 'bottom'}}
                    </button>
                    <ul class="dropdown-menu left" role="menu">
                        {{#if ../../view.allowFreezeFirstColumn}}
                            <li role="menuitem" class="menuitem-config">
                                <span class="flex gap-2">
                                    <span>{{str 'LBL_LISTVIEW_FREEZE_COLUMN_1'}}</span>
                                    <input type="checkbox" {{#if ../../../view.isFirstColumnFreezed}} checked{{/if}} data-action="freeze-first-column">
                                </span>
                            </li>
                            <li class="divider" data-settings-li="widths" aria-hidden="true"></li>
                        {{/if}}
                        {{#each ../../view._fields.all}}
                            <li role="menuitem">
                                <button class="{{#if selected}}active{{/if}}" data-field-toggle="{{name}}" track="click:{{name}}">
                                    {{#if selected}}<i class="sicon sicon-check"></i> {{/if}}{{str label ../../../view.module}}
                                </button>
                            </li>
                        {{/each}}
                        <li class="divider" data-settings-li="order" aria-hidden="true"></li>
                        <li data-settings-li="order" role="menuitem">
                            <button data-columns-order="reset">
                                <i class="icon sicon sicon-reset"></i> {{str 'LBL_RESET_DEFAULT_VIEW' ../../view.module}}
                            </button>
                        </li>
                        <li class="divider" data-settings-li="widths" aria-hidden="true"></li>
                        <li data-settings-li="widths" role="menuitem">
                            <button data-widths="reset">
                                <i class="icon sicon sicon-reset"></i> {{str 'LBL_RESET_DEFAULT_WIDTHS' ../../view.module}}
                            </button>
                        </li>
                    </ul>
                </div>
            </th>
        {{else}}
            <th{{#if name}} data-fieldname="{{name}}"{{/if}}>
                <span>
                    {{field ../../view template="list-header"}}
                </span>
            </th>
        {{/if}}
    {{/each}}
</tr>
<tr>
    <th data-target="alert-container" class="alert alert-warning hide"{{#if view.colSpan}} colspan="{{../view.colSpan}}"{{else}} colspan="100%"{{/if}}>
        <div class="alert-list-contents flex hover:bg-[--tab-background-hover-color] items-center justify-center ltr:left-0 rtl:right-0 mt-0 p-2.5 sticky top-0" data-target="alert">
        </div>
    </th>
</tr>

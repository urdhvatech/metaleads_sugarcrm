<div class="inline-drawer filtered-search">
    <article class="inline-drawer-header row-fluid">
        <div class="filtered-search__input-row">
            <div class="filtered-search__input-wrap">
                <input type="text"
                       data-searchfield="true"
                       placeholder="{{str 'LBL_SEARCH_BY' this.module}}"
                       class="search search-input filtered-search__input"
                       value="{{searchTerm}}">
                <button type="button"
                        data-action="clearSearch"
                        class="btn-link filtered-search__clear{{#unless searchTerm}} hide{{/unless}}"
                        aria-label="{{str 'LBL_CLEAR_BUTTON_LABEL'}}">
                    <i class="sicon sicon-remove"></i>
                </button>
            </div>
        </div>
    </article>
</div>

<style id="hide-bwc-iframe-loading" type="text/css">
    #bwc-frame {
        visibility: hidden !important;
    }
</style>

<iframe class="bwc-frame" id="bwc-frame" src="{{url}}"></iframe>

<script type="text/javascript">
    // This script runs immediately when the browser parses the script tag
    // after the Handlebars output is inserted into the DOM.
    (function() {
        const iframe = document.getElementById('bwc-frame');

        function showBwcIframe() {
            // Remove style that's hiding the iframe while it's loading
            let helperStyle = document.getElementById('hide-bwc-iframe-loading');
            if (helperStyle) {
                helperStyle.remove();
            }
        }

        if (iframe) {
            // This will catch loads that happen *after* this script executes.
            iframe.addEventListener('load', showBwcIframe);
            // Immediately check if the iframe has *already* finished loading
            // This handles the race condition where the iframe loads *before* this script executes.
            try {
                // Check if the iframe's document is accessible and its state is 'complete'
                // state can be 'loading', 'interactive', or 'complete'
                if (iframe.contentDocument && iframe.contentDocument.readyState === 'complete') {
                    // The iframe content is already loaded or finished loading right now.
                    // Execute the handler directly.
                    showBwcIframe();
                }
            } catch (e) {
                // This block catches SecurityErrors if same-origin policy prevents access to contentDocument.
                // It might also catch other errors if the iframe element is somehow not fully ready yet,
                // though readyState check is usually safe once the element is in the DOM.
                console.warn('Could not check iframe readyState immediately (potential same-origin issue or timing):', e);
            }
        } else {
            console.error('Iframe with id "bwc-frame" not found immediately after script execution. Check Handlebars output and DOM insertion.');
        }
    })();
</script>

{{!--
Per-account lead assignment, forms, and field mapping.
--}}
<style>
.ut-sm-account .headerpane { position: relative; }
.ut-sm-account .ut-sm-body { padding: 8px 24px 40px; max-width: 980px; }
.ut-sm-account .checkbox-list { max-height: 240px; overflow: auto; border: 1px solid var(--border-color, #e5e7eb); padding: 10px 14px; }
.ut-sm-account .checkbox-grid { max-height: 280px; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 6px 16px; }
.ut-sm-account .mapping-block { margin-bottom: 16px; }
.ut-sm-account .label-instagram { background: #fce7f3; color: #9d174d; }
.ut-sm-account .label-facebook { background: #e0e7ff; color: #3730a3; }
</style>

<div class="ut-sm-account">
    <div class="headerpane">
        <h1>
            <span class="record-cell">
                <span class="module-title">
                    {{str "LBL_UT_SM_LEAD_SETTINGS_FOR" "ut_sm"}}
                    {{#if account}}{{account.page_name}}{{/if}}
                </span>
            </span>
            <div class="btn-toolbar pull-right">
                <a class="btn btn-invisible" data-action="cancel" href="javascript:void(0);">{{str "LBL_UT_SM_CANCEL" "ut_sm"}}</a>
                <a class="btn btn-primary" data-action="save" href="javascript:void(0);">{{str "LBL_UT_SM_SAVE_CONFIGURATION" "ut_sm"}}</a>
            </div>
        </h1>
    </div>

    {{#if account}}
    <div class="ut-sm-body">
        <p>
            {{#if account.is_instagram}}
                <span class="label label-instagram">{{str "LBL_UT_SM_TYPE_INSTAGRAM" "ut_sm"}}</span>
            {{else}}
                <span class="label label-facebook">{{str "LBL_UT_SM_TYPE_FACEBOOK" "ut_sm"}}</span>
            {{/if}}
        </p>

        <div class="record-panel">
            <div class="row-fluid record-panel-header"><h4>{{str "LBL_UT_SM_LEAD_ASSIGNMENT" "ut_sm"}}</h4></div>
            <div class="record-panel-content">
                <div class="control-group">
                    <label for="ut-sm-assignment-type">{{str "LBL_UT_SM_ASSIGN_NEW_LEADS_TO" "ut_sm"}}</label>
                    <select id="ut-sm-assignment-type" name="assignment_type">
                        <option value="keep_empty" {{#eq account.assignment_type "keep_empty"}}selected{{/eq}}>{{str "LBL_UT_SM_ASSIGN_KEEP_EMPTY" "ut_sm"}}</option>
                        <option value="round_robin" {{#eq account.assignment_type "round_robin"}}selected{{/eq}}>{{str "LBL_UT_SM_ASSIGN_ROUND_ROBIN" "ut_sm"}}</option>
                        <option value="specific_user" {{#eq account.assignment_type "specific_user"}}selected{{/eq}}>{{str "LBL_UT_SM_ASSIGN_SPECIFIC_USER" "ut_sm"}}</option>
                        <option value="security_group" {{#eq account.assignment_type "security_group"}}selected{{/eq}}>{{str "LBL_UT_SM_ASSIGN_SECURITY_GROUP" "ut_sm"}}</option>
                    </select>
                </div>

                <div class="control-group" data-panel="round_robin" {{#unless showRoundRobin}}style="display:none"{{/unless}}>
                    <label>{{str "LBL_UT_SM_RR_USERS" "ut_sm"}}</label>
                    <p class="help-block">{{str "LBL_UT_SM_RR_USERS_HELP" "ut_sm"}}</p>
                    {{#if hasUsers}}
                        <div class="checkbox-list checkbox-grid">
                            {{#each account.users}}
                                <label><input type="checkbox" name="rr_user_ids" value="{{id}}" {{#if rr_checked}}checked{{/if}}> {{name}}</label>
                            {{/each}}
                        </div>
                    {{else}}
                        <div class="alert alert-info">{{str "LBL_UT_SM_NO_USERS" "ut_sm"}}</div>
                    {{/if}}
                </div>

                <div class="control-group" data-panel="specific_user" {{#unless showSpecificUser}}style="display:none"{{/unless}}>
                    <label for="ut-sm-user">{{str "LBL_UT_SM_USER" "ut_sm"}}</label>
                    <select id="ut-sm-user" name="assignment_user_id">
                        <option value="">{{str "LBL_UT_SM_SELECT_USER" "ut_sm"}}</option>
                        {{#each account.users}}
                            <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="control-group" data-panel="security_group" {{#unless showSecurityGroup}}style="display:none"{{/unless}}>
                    <label for="ut-sm-group">{{str "LBL_UT_SM_SECURITY_GROUP" "ut_sm"}}</label>
                    {{#if hasSecurityGroups}}
                        <select id="ut-sm-group" name="assignment_group_id">
                            <option value="">{{str "LBL_UT_SM_SELECT_GROUP" "ut_sm"}}</option>
                            {{#each account.security_groups}}
                                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                        <p class="help-block">{{str "LBL_UT_SM_SECURITY_GROUP_HELP" "ut_sm"}}</p>
                    {{else}}
                        <div class="alert alert-info">{{str "LBL_UT_SM_NO_SECURITY_GROUPS" "ut_sm"}}</div>
                    {{/if}}
                </div>
            </div>
        </div>

        <div class="record-panel">
            <div class="row-fluid record-panel-header"><h4>{{str "LBL_UT_SM_LEAD_FORMS" "ut_sm"}}</h4></div>
            <div class="record-panel-content">
                <p class="help-block">{{str "LBL_UT_SM_LEAD_FORMS_HELP" "ut_sm"}}</p>
                <p><a class="btn" data-action="refresh-forms" href="javascript:void(0);">{{str "LBL_UT_SM_REFRESH_FORMS" "ut_sm"}}</a></p>
                {{#if hasForms}}
                    <div class="checkbox-list">
                        {{#each account.forms}}
                            <label><input type="checkbox" name="enabled_form_ids" value="{{form_id}}" {{#if enabled}}checked{{/if}}> {{form_name}}</label>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="alert alert-info">{{str "LBL_UT_SM_NO_FORMS_YET" "ut_sm"}}</div>
                {{/if}}
            </div>
        </div>

        <div class="record-panel">
            <div class="row-fluid record-panel-header"><h4>{{str "LBL_UT_SM_FIELD_MAPPING" "ut_sm"}}</h4></div>
            <div class="record-panel-content">
                <p class="help-block">{{str "LBL_UT_SM_FIELD_MAPPING_HELP" "ut_sm"}}</p>
                {{#if hasFormMappings}}
                    {{#each account.forms_with_mappings}}
                        <div class="mapping-block">
                            <h5>{{str "LBL_UT_SM_FORM_MAPPING_HEADING" "ut_sm"}}: {{form_name}}</h5>
                            {{#if has_mappings}}
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>{{str "LBL_UT_SM_META_FIELD" "ut_sm"}}</th>
                                            <th>{{str "LBL_UT_SM_SUITECRM_FIELD" "ut_sm"}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each mappings}}
                                            <tr>
                                                <td>{{meta_field_label}}</td>
                                                <td>
                                                    <select data-form-id="{{../form_id}}" data-meta-key="{{meta_field_key}}">
                                                        {{#each crm_options}}
                                                            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                                        {{/each}}
                                                    </select>
                                                </td>
                                            </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                                {{#if has_warnings}}
                                    {{#each warnings}}
                                        <div class="alert alert-info">{{this}}</div>
                                    {{/each}}
                                {{/if}}
                            {{else}}
                                <div class="alert alert-info">{{str "LBL_UT_SM_NO_QUESTIONS_FOR_FORM" "ut_sm"}}</div>
                            {{/if}}
                        </div>
                    {{/each}}
                {{else}}
                    <div class="alert alert-info">{{str "LBL_UT_SM_NO_MAPPING_YET" "ut_sm"}}</div>
                {{/if}}
            </div>
        </div>
    </div>
    {{/if}}
</div>

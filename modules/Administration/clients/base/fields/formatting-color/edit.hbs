<div class="formatting-color">
    <input class="colorValue cursor-pointer ltr:mr-2 rtl:ml-2" type="color" {{#if value}} value="{{value}}" {{/if}}>
    <div class="w-full">
        <input class="textValue hexvar w-full" type="text" {{#if value}} value="{{value}}" {{/if}}>
        <div class="hex-error text-xs text-[--red-500] mt-1 hidden">{{str 'LBL_DROPDOWN_HEX_REQUIRED' module}}</div>
    </div>
</div>

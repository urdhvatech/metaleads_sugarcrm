<div class="headerpane bg-[--foreground-base] box-border fixed">
    <h1>
        <span class="record-cell">
            <span class="module-title">{{str 'LBL_DRIVE_PATH_CONFIG' module}} - {{driveTypeLabel}}</span>
        </span>
        <div class="btn-toolbar pull-right dropdown">
            {{#each meta.buttons}}
                {{#eq this.name 'shared_button'}}
                    <input type="checkbox" class="sharedWithMe" {{#eq ../../context.attributes.driveType 'sharepoint'}} checked disabled {{/eq}}/>
                {{/eq}}
                {{#eq this.name 'sharedDrive_button'}}
                      <input type="checkbox" class="sharedDrives ml-2" {{#notEq ../../context.attributes.driveType 'google'}} hidden {{/notEq}}/>
                {{/eq}}
                {{field ../this}}
            {{/each}}
        </div>
    </h1>
</div>

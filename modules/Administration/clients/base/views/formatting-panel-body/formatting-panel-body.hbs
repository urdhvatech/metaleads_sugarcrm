<div class="block preview-data rounded-lg shadow body-formatting">
    <h4 class="ellipsis_inline" data-bs-placement="bottom">
        {{str meta.label this.module}}
    </h4>
    {{#each meta.panels}}
        {{#if inline}}
            <div class="formatting-panel-inline">
        {{/if}}
        {{#each fields}}
            <div class="field-row" data-name="{{name}}" data-type="{{type}}">
                <div class="field-label">
                    {{str  label ../../model.module}}
                </div>
                <div class="field-value">
                    {{field ../../this model=../../model template="edit"}}
                </div>
            </div>
        {{/each}}
        {{#if inline}}
            </div>
        {{/if}}
    {{/each}}
</div>

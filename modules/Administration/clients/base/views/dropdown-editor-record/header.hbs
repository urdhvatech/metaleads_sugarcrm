<tr class="flex-list-row-header sticky top-0 z-0">
    {{#each view.meta.panels}}
        {{#each fields}}
            <th data-fieldname="{{name}}" class="px-4 font-normal">
                {{#eq this.type 'bool'}}
                    <input type="checkbox" class="toggle_all">
                {{else}}
                    <span class="list-header">
                        {{str label ../../../view.module}}
                    </span>
                {{/eq}}
                {{#if sortDirection}}
                    <span class="sicon sicon-{{sortDirection}} pull-right"></span>
                {{/if}}
            </th>
        {{/each}}
        {{#if ../this.isBaseRole}}
            <th data-fieldname="dropdown_controls" class="w-24"></th>
        {{/if}}
    {{/each}}
</tr>

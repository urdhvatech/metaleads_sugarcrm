<div class="alert-page-overlay mt-[50px]">
    <div class="alert alert-info alert-block rounded-md shadow-lg bg-[--alert-background] m-auto z-[1060]">
        <div class="alert-content text-center pt-5">
            <div class="indicator alert-status"></div>
            <span class="text loading loading-admin">
                <span id="ci-progress-lbl">
                    <strong>{{initialTitle}}</strong>
                    <i class="l1">&#46;</i>
                    <i class="l2">&#46;</i>
                    <i class="l3">&#46;</i>
                </span>
                <span id="ci-progress-success-lbl" style="display:none">
                    <strong>{{successTitle}}</strong>
                </span>
                <span id="ci-progress-error-lbl" style="display:none">
                    <strong>{{errorTitle}}</strong>
                </span>
            </span>

            <div class="pt-0 pl-2.5 pb-0 pr-2.5">
                <h5>0%</h5>
                <div class="progress">
                    <div class="bar w-0"></div>
                </div>

                <div class="text-left mt-5 ml-0 mb-2.5 mr-0">
                    <a href="#" id="pb-display-log-link">{{str 'LBL_PACKAGE_BUILDER_DISPLAY_LOG' 'Administration'}}</a>
                    <i class="sicon sicon-chevron-down"></i>
                    <pre class="max-h-[150px] overflow-auto mt-4"></pre>
                </div>
            </div>
            <button class="indicator alert-close" id="pb-alert-close-btn" style="display:none">
                {{str 'LBL_PACKAGE_BUILDER_CLOSE' 'Administration'}}
            </button>
        </div>
    </div>
</div>

<script type="text/javascript">
    (function() {
        var link = document.getElementById('pb-display-log-link');
        if (link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                var parent = link.parentElement;
                var pre = parent.querySelector('pre');
                var icon = parent.querySelector('i');
                if (pre) {
                    pre.style.display = pre.style.display === 'none' || !pre.style.display ? 'block' : 'none';
                    pre.scrollTop = pre.scrollHeight;
                }
                if (icon) {
                    icon.classList.toggle('sicon-chevron-down');
                    icon.classList.toggle('sicon-chevron-up');
                }
                return false;
            });
        }

        var closeBtn = document.getElementById('pb-alert-close-btn');
        if (closeBtn) {
            closeBtn.addEventListener('click', function() {
                var alertOverlay = closeBtn.closest('.alert-page-overlay');
                if (alertOverlay) {
                    alertOverlay.remove();
                }
            });
        }
    })();
</script>

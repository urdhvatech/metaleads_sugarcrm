<div class="timeline-config ml-5 mr-5 full-width">
    <h5>{{str 'LBL_HISTORICALLY_DELTA_SETTINGS_SUB_TITLE' module}}</h5>
    {{#each availableFields}}
        <div class="row-fluid">
            <label>
                <input type="checkbox"
                    name="{{name}}"
                    data-name="{{name}}"
                    {{#if enabled}}checked{{/if}}>
                {{str vname ../configModule}}
            </label>
        </div>
    {{/each}}
</div>

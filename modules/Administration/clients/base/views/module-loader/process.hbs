<div class="alert-page-overlay"></div>

<div class="alert alert-info alert-block rounded-md shadow-lg bg-[--alert-background] z-[1060]">
    <div style="flex:max-content;position:relative;width:100%;" class="text-center pt-5">
        <div class="indicator" style="width:100%;height:60px;position:absolute;z-index:-1;"></div>
        <span class="text loading loading-admin">
            <span id="ml-installing-lbl">
                <strong>{{str "LBL_ML_PACKAGE_INSTALLING" "Administration"}}</strong>
                <i class="l1">&#46;</i>
                <i class="l2">&#46;</i>
                <i class="l3">&#46;</i>
            </span>
            <span id="ml-uninstalling-lbl" style="display: none">
                <strong>{{str "LBL_ML_PACKAGE_UNINSTALLING" "Administration"}}</strong>
                <i class="l1">&#46;</i>
                <i class="l2">&#46;</i>
                <i class="l3">&#46;</i>
            </span>
            <span id="ml-installing-success-lbl" style="display:none">
                <strong>{{str "LBL_ML_INSTALLATION_SUCCESSFUL" "Administration"}}</strong>
            </span>
            <span id="ml-installing-error-lbl" style="display:none">
                <strong>{{str "LBL_ML_INSTALLATION_ERROR" "Administration"}}</strong>
            </span>
            <span id="ml-uninstalling-success-lbl" style="display:none">
                <strong>{{str "LBL_ML_UNINSTALLATION_SUCCESSFUL" "Administration"}}</strong>
            </span>
            <span id="ml-uninstalling-error-lbl" style="display:none">
                <strong>{{str "LBL_ML_UNINSTALLATION_ERROR" "Administration"}}</strong>
            </span>
        </span>

        <div style="padding:0 10px">
            <h5>0%</h5>
            <div class="progress"><div class="bar" style="width:0%;"></div></div>

            <div style="margin:20px 0 10px;" class="text-left">
                <a href="#" id="ml-display-log-link">Display Log</a>
                <i class="sicon sicon-chevron-down"></i>
                <pre style="max-height:150px;overflow:auto;display:none;margin-top:20px;word-break:break-word;"></pre>
            </div>
        </div>
        <button class="indicator"
            style="width: 100%;border:0 none;height:36px;font-weight:bold;color:#717171;display:none">Close</button>
    </div>
</div>

<script type="text/javascript">
    (function() {
        var link = document.getElementById('ml-display-log-link');
        if (link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                var parent = link.parentElement;
                var pre = parent.querySelector('pre');
                var icon = parent.querySelector('i');
                if (pre) {
                    pre.style.display = pre.style.display === 'none' || !pre.style.display ? 'block' : 'none';
                    pre.scrollTop = pre.scrollHeight;
                }
                if (icon) {
                    icon.classList.toggle('sicon-chevron-down');
                    icon.classList.toggle('sicon-chevron-up');
                }
                return false;
            });
        }

        var closeButton = document.querySelector('.alert button.indicator');
        if (closeButton) {
            closeButton.addEventListener('click', function() {
                var alert = this.closest('.alert');
                if (alert && alert.parentElement) {
                    alert.parentElement.remove();
                }
            });
        }
    })();
</script>

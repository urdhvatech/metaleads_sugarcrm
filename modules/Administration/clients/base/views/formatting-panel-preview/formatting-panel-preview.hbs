{{#with this.itemModel.attributes}}
    <div class="block preview-data rounded-lg shadow w-fit flex preview-formatting"
         style="
             color: {{dropdownStyle.text.color}};
             background-color: {{dropdownStyle.backgroundColor}};
             {{#if dropdownStyle.text.isBold}}font-weight: bold; {{/if}}
             {{#if dropdownStyle.text.isItalic}}font-style: italic; {{/if}}
             text-decoration:
             {{#if dropdownStyle.text.isUnderline}} underline {{/if}}
             {{#if dropdownStyle.text.isLineThrough}} line-through {{/if}};"
    >
        {{#if dropdownStyle.icon.class}}
            <i style="color: {{dropdownStyle.icon.color}};"
               class="sicon sicon-{{dropdownStyle.icon.class}} ltr:mr-1.5 rtl:ml-1.5">
            </i>
        {{/if}}
        {{~dropdown_label~}}
    </div>
{{/with}}

{
  "name": "@sugarcrm/maple-syrup",
  "version": "2.1.1",
  "description": "A design token implementation for Sugar products.",
  "main": "index.js",
  "repository": "git@github.com:sugarcrm/maple-syrup.git",
  "author": "Scott King <scott.king@sugarcrm.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build_legacy": "style-dictionary build --config ./config.js",
    "build": "node build ./build.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest": {
    "rootDir": "./",
    "testPathIgnorePatterns": ["<rootDir>/node_modules/"],
    "transform": {
      ".+\\.(css)$": "<rootDir>/jest/maple-syrup-css-transformer.cjs"
    }
  },
  "dependencies": {
    "style-dictionary": "^3.9.1"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "resolutions": {
    "wrap-ansi": "^7.0.0",
    "string-width": "^4.2.3"
  }
}
